{
  "name": "@yevgetman/sov-debug-console",
  "version": "0.3.0",
  "description": "The Sovereign AI debug console — a framework-agnostic custom element for inspecting an agent's machinery, telemetry, and data changes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "keywords": ["agent", "ai", "debug", "console", "custom-element", "web-component", "sovereign"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yevgetman/sovereign-ai-sdk.git",
    "directory": "packages/debug-console"
  },
  "homepage": "https://github.com/yevgetman/sovereign-ai-sdk/tree/master/packages/debug-console#readme",
  "bugs": {
    "url": "https://github.com/yevgetman/sovereign-ai-sdk/issues"
  },
  "files": ["dist", "src", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./iife": "./dist/sov-debug-console.iife.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run scripts/build-iife.mjs",
    "prepack": "rm -rf dist && bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "sideEffects": ["./dist/iife-entry.js", "./dist/sov-debug-console.iife.js"]
}
