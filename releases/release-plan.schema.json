{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node",
    "updated_at",
    "product",
    "checkout",
    "last_release",
    "reconciliation",
    "release"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "node": {
      "const": "sovereign-ai"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "const": "sovereign-ai-sdk"
    },
    "checkout": {
      "type": "string",
      "minLength": 1
    },
    "last_release": {
      "anyOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "null"
        }
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_start_commit",
        "through_main_commit",
        "checked_at",
        "evidence"
      ],
      "properties": {
        "history_start_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "through_main_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "release": {
      "$ref": "#/$defs/release"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereign-ai:sovereign-ai-sdk:release-plan:v4",
  "title": "Sovereign AI SDK release plan v4",
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_commit",
        "evidence",
        "cli_version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Must equal the planned manifest version, including an empty draft."
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product",
        "version",
        "status",
        "base",
        "applied_commits",
        "preparation_commits",
        "build_commit",
        "frozen_manifest_commit",
        "authorization",
        "validation",
        "artifacts",
        "published_at",
        "publication_evidence",
        "manifest_sha256",
        "cli_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "const": "sovereign-ai-sdk"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Must equal the planned manifest version, including an empty draft."
        },
        "status": {
          "enum": [
            "draft",
            "frozen",
            "released",
            "cancelled"
          ]
        },
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/base"
            },
            {
              "type": "null"
            }
          ]
        },
        "applied_commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "source_commit",
              "release_commit"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "release_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "preparation_commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "reason",
              "review",
              "item_id"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "An existing release.applied_commits release_commit for that manifest item, never an extra unlisted commit."
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "review": {
                "type": "string",
                "minLength": 1
              },
              "item_id": {
                "type": "string",
                "minLength": 1,
                "description": "The manifest item whose applied result commit this preparation reviews; does not add release membership."
              }
            }
          }
        },
        "build_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_manifest_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/authorization"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_evidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cli_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "frozen",
                  "released"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "$ref": "#/$defs/base"
              },
              "build_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "validation": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/validation"
                    },
                    {
                      "properties": {
                        "result": {
                          "const": "pass"
                        }
                      }
                    }
                  ]
                }
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "released"
              }
            }
          },
          "then": {
            "properties": {
              "frozen_manifest_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "authorization": {
                "$ref": "#/$defs/authorization"
              },
              "artifacts": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/artifact"
                }
              },
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "publication_evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "at",
        "build_commit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "owner-approval"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "build_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "result",
        "build_commit",
        "evidence"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "build_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "filename",
        "sha256",
        "location"
      ],
      "properties": {
        "arch": {
          "enum": [
            "package",
            "darwin-arm64",
            "darwin-x64",
            "linux-arm64",
            "linux-x64",
            "windows-x64"
          ]
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
